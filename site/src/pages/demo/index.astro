<!doctype html>
<html lang="en" data-view="published">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SiteVerum interactive demo</title>
  <link rel="stylesheet" href="assets/leaflet/leaflet.css">
  <link rel="stylesheet" href="assets/viewer.css">
  <link rel="stylesheet" href="demo.css">
  <script is:inline defer src="assets/leaflet/leaflet.js"></script>
  <script is:inline defer src="assets/viewer.js"></script>
  <script is:inline defer src="demo.js"></script>
</head>
<body>
  <header><h1>SiteVerum demo</h1><span>Read-only survey</span><a href="../">Documentation</a></header>
  <section class="published">
    <p class="notice" id="dataset-notice">Explore a sample survey. Video processing requires a local installation. OpenStreetMap requests tiles from its servers.</p>
    <p id="message" role="status"></p>
    <div id="results" hidden><div class="viewer">
      <div id="map" aria-label="Survey map"></div>
      <figure>
        <img id="photo" alt="Survey image">
        <figcaption id="caption"></figcaption>
        <div class="photo-controls"><button id="previous">Previous photo</button><button id="next">Next photo</button><a id="download-photo" download>Download image</a></div>
      </figure>
    </div></div>
  </section>
</body>
</html>
